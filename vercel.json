{
  "functions": {
    "api/rocks.ts": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "api/_rocks/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mywally.gearup.wtf"
        }
      ],
      "destination": "/wally.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rocks.gearup.wtf"
        }
      ],
      "destination": "/rocks.html"
    },
    {
      "source": "/api/usage/blob",
      "destination": "/api/info?fn=usage"
    },
    {
      "source": "/wally",
      "destination": "/wally.html"
    },
    {
      "source": "/wally/:path*",
      "destination": "/wally.html"
    },
    {
      "source": "/api/gear/:path*",
      "destination": "/api/info?fn=gear&route=:path*"
    },
    {
      "source": "/gear/desk",
      "destination": "/desk.html"
    },
    {
      "source": "/gear/assets/:f*",
      "destination": "/assets/:f*"
    },
    {
      "source": "/gear/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/desk",
      "destination": "/desk.html"
    },
    {
      "source": "/gear",
      "destination": "/gear.html"
    },
    {
      "source": "/backup",
      "destination": "/backup.html"
    },
    {
      "source": "/owner",
      "destination": "/owner.html"
    },
    {
      "source": "/api/quote",
      "destination": "/api/info?fn=quote"
    },
    {
      "source": "/api/status",
      "destination": "/api/info?fn=status"
    },
    {
      "source": "/api/rocks/:path*",
      "destination": "/api/rocks?route=:path*"
    },
    {
      "source": "/rocks/:sub*/assets/:f*",
      "destination": "/assets/:f*"
    },
    {
      "source": "/rocks/assets/:f*",
      "destination": "/assets/:f*"
    },
    {
      "source": "/rocks/:sub*/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/rocks/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/rocks",
      "destination": "/rocks.html"
    },
    {
      "source": "/rocks/:path*",
      "destination": "/rocks.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/farcaster.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}